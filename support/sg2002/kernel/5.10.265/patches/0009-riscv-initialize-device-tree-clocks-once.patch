From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hardened NanoKVM kernel port <noreply@local>
Date: Sun, 23 Aug 2026 22:45:25 +0300
Subject: [PATCH 9/9] riscv: initialize device-tree clocks once

---
 arch/riscv/kernel/time.c | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/arch/riscv/kernel/time.c b/arch/riscv/kernel/time.c
index d58b591279..303ae47dfb 100644
--- a/arch/riscv/kernel/time.c
+++ b/arch/riscv/kernel/time.c
@@ -7,7 +7,6 @@
 #include <linux/of_clk.h>
 #include <linux/clockchips.h>
 #include <linux/clocksource.h>
-#include <linux/of_clk.h>
 #include <linux/delay.h>
 #include <asm/sbi.h>
 #include <asm/processor.h>
@@ -26,8 +25,6 @@ void __init time_init(void)
 	of_node_put(cpu);
 	riscv_timebase = prop;
 
-	of_clk_init(NULL);
-
 	lpj_fine = riscv_timebase / HZ;
 
 	of_clk_init(NULL);
