#!/bin/sh
if [ -e /run/nanokvm-restore-blocked ]; then
    echo "S01restore: raw restore is blocked" >&2
    exit 1
fi
if [ ! -x /usr/libexec/nanokvm-early-restore ]; then
    printf 'raw early restore helper is missing\n' > /run/nanokvm-restore-blocked
    chmod 0600 /run/nanokvm-restore-blocked
    echo "S01restore: raw restore helper is missing" >&2
    exit 1
fi
if ! /usr/libexec/nanokvm-early-restore; then
    # The helper writes this itself, unless it was killed or could not start.
    printf 'raw early restore failed\n' > /run/nanokvm-restore-blocked
    chmod 0600 /run/nanokvm-restore-blocked
    echo "S01restore: raw early restore failed" >&2
    exit 1
fi
# Init named the system from the file of the image before this script ran.
hostname -F /etc/hostname 2>/dev/null || true
