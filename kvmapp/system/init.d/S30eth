#!/bin/sh
set -f
if [ -e /run/nanokvm-restore-blocked ]; then
    echo "$0: raw restore is blocked" >&2
    exit 1
fi

RESERVE_INET="192.168.90.1/22"
ETH_MAC_FILE="/boot/eth.mac"
IPV6_MODE_FILE="/boot/eth.ipv6.mode"
IPV6_CONFIG_FILE="/boot/eth.ipv6"
BOOT_RESOLV_FILE="${BOOT_RESOLV_FILE:-/boot/resolv.conf}"
ETC_RESOLV_FILE="${ETC_RESOLV_FILE:-/etc/resolv.conf}"
UDHCPC6_PID_FILE="/run/udhcpc6.eth0.pid"
UDHCPC6_SCRIPT="/kvmapp/system/network/udhcpc6.script"

clean_line() {
    echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\r//g'
}

is_valid_mac() {
    echo "$1" | grep -qiE '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'
}

is_ipv4_addr() {
    value="$1"
    case "$value" in
        ''|*[!0-9.]*|.*|*.|*..*) return 1 ;;
    esac
    old_ifs="$IFS"
    IFS=.
    set -- $value
    IFS="$old_ifs"
    [ "$#" -eq 4 ] || return 1
    for octet in "$@"; do
        [ -n "$octet" ] || return 1
        [ "${#octet}" -le 3 ] || return 1
        case "$octet" in
            0) ;;
            0*) return 1 ;;
        esac
        [ "$octet" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

is_ipv4_netid() {
    case "$1" in
        ''|*[!0-9]*|0*) return 1 ;;
    esac
    [ "${#1}" -le 2 ] || return 1
    [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 32 ] 2>/dev/null
}

is_ipv6_addr() {
    value="$1"
    [ -n "$value" ] || return 1
    [ "${#value}" -le 45 ] || return 1
    case "$value" in
        *:*) ;;
        *) return 1 ;;
    esac
    case "$value" in
        *[!0-9A-Fa-f:.]*) return 1 ;;
    esac
    return 0
}

is_ipv6_cidr() {
    value="$1"
    case "$value" in
        */*) addr="${value%/*}"; prefix="${value#*/}" ;;
        *) return 1 ;;
    esac
    is_ipv6_addr "$addr" || return 1
    case "$prefix" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "${#prefix}" -le 3 ] || return 1
    [ "$prefix" -ge 0 ] 2>/dev/null && [ "$prefix" -le 128 ] 2>/dev/null
}

stable_eth_mac_seed() {
    for file in /device_key /etc/machine-id
    do
        if [ -s "$file" ]
        then
            seed=$(tr -cd 'A-Fa-f0-9' < "$file" | head -c 32)
            if [ -n "$seed" ]
            then
                echo "$seed"
                return
            fi
        fi
    done

    if [ -r /proc/cpuinfo ]
    then
        seed=$(sed -n 's/^[Ss]erial[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | tr -cd 'A-Fa-f0-9' | head -c 32)
        if [ -n "$seed" ]
        then
            echo "$seed"
            return
        fi
    fi

    if [ -r /sys/class/net/eth0/address ]
    then
        seed=$(tr -cd 'A-Fa-f0-9' < /sys/class/net/eth0/address | head -c 12)
        if [ -n "$seed" ]
        then
            echo "$seed"
            return
        fi
    fi

    echo 0123456789abcdef
}

make_eth_mac() {
    seed=$(stable_eth_mac_seed)
    hash=$(printf '%s:eth0\n' "$seed" | sha256sum | awk '{print $1}')
    if [ -z "$hash" ]
    then
        hash=0123456789abcdef
    fi
    printf '%s\n' "$hash" | sed 's/^\(..\)\(..\)\(..\)\(..\)\(..\).*/02:\1:\2:\3:\4:\5/'
}

ensure_eth_mac() {
    [ -e /sys/class/net/eth0/address ] || return

    mac=""
    if [ -s "$ETH_MAC_FILE" ]
    then
        mac=$(clean_line "$(cat "$ETH_MAC_FILE")")
    fi

    if ! is_valid_mac "$mac"
    then
        mac=$(make_eth_mac)
        echo "$mac" > "$ETH_MAC_FILE" 2>/dev/null || true
    fi

    is_valid_mac "$mac" || return
    ip link set dev eth0 down 2>/dev/null || true
    ip link set dev eth0 address "$mac" 2>/dev/null || true
    ip link set dev eth0 up 2>/dev/null || true
}

write_ipv6_conf() {
    name="$1"
    value="$2"
    path="/proc/sys/net/ipv6/conf/eth0/$name"
    [ -e "$path" ] && echo "$value" > "$path" 2>/dev/null || true
}

read_ipv6_mode() {
    mode=""
    [ -s "$IPV6_MODE_FILE" ] && mode=$(clean_line "$(cat "$IPV6_MODE_FILE")")
    case "$mode" in
        slaac|dhcpv6|manual|disabled) echo "$mode" ;;
        *) echo disabled ;;
    esac
}

stop_dhcpv6() {
    if [ -e "$UDHCPC6_PID_FILE" ]; then
        kill "$(cat "$UDHCPC6_PID_FILE")" 2>/dev/null || true
        rm -f "$UDHCPC6_PID_FILE"
    fi
    killall udhcpc6 2>/dev/null || true
}

find_udhcpc6() {
    for path in /kvmapp/system/bin/udhcpc6 /usr/sbin/udhcpc6 /sbin/udhcpc6 /usr/bin/udhcpc6 /bin/udhcpc6
    do
        [ -x "$path" ] && echo "$path" && return 0
    done
    return 1
}

ensure_ipv6_drop_rule() {
    command -v ip6tables >/dev/null 2>&1 || return
    ip6tables -C INPUT -i eth0 -j DROP 2>/dev/null || \
        ip6tables -I INPUT 1 -i eth0 -j DROP 2>/dev/null || true
}

remove_ipv6_drop_rule() {
    command -v ip6tables >/dev/null 2>&1 || return
    while ip6tables -D INPUT -i eth0 -j DROP 2>/dev/null
    do
        :
    done
}

enable_ipv6_base() {
    [ -d /proc/sys/net/ipv6/conf/eth0 ] || return 1
    write_ipv6_conf disable_ipv6 0
    remove_ipv6_drop_rule
    return 0
}

flush_ipv6_global() {
    ip -6 addr flush dev eth0 scope global 2>/dev/null || true
}

apply_ipv6_disabled() {
    stop_dhcpv6
    write_ipv6_conf accept_ra 0
    write_ipv6_conf autoconf 0
    flush_ipv6_global
    write_ipv6_conf disable_ipv6 1
    ensure_ipv6_drop_rule
}

apply_ipv6_slaac() {
    stop_dhcpv6
    enable_ipv6_base || return 0
    write_ipv6_conf accept_ra 2
    write_ipv6_conf autoconf 1
    flush_ipv6_global
}

apply_ipv6_dhcpv6() {
    /usr/libexec/nanokvm-app-recovery gate >/dev/null || return 1
    stop_dhcpv6
    enable_ipv6_base || return 0
    write_ipv6_conf accept_ra 2
    write_ipv6_conf autoconf 0
    flush_ipv6_global

    client=$(find_udhcpc6) || {
        echo "udhcpc6 not found; DHCPv6 mode cannot start" >&2
        return 0
    }
    if [ ! -x "$UDHCPC6_SCRIPT" ]; then
        echo "udhcpc6 hook not found; DHCPv6 mode cannot start safely" >&2
        return 0
    fi
    "$client" -i eth0 -s "$UDHCPC6_SCRIPT" -t 10 -T 1 -A 5 -b -p "$UDHCPC6_PID_FILE" >/dev/null 2>&1 &
}

apply_ipv6_manual() {
    stop_dhcpv6
    enable_ipv6_base || return 0
    write_ipv6_conf accept_ra 0
    write_ipv6_conf autoconf 0
    flush_ipv6_global

    [ -s "$IPV6_CONFIG_FILE" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=$(clean_line "$line")
        [ -z "$line" ] && continue
        set -- $line
        inet="$1"
        gw="$2"
        [ -n "$inet" ] || continue
        case "$inet" in
            */*) ;;
            *) inet="$inet/64" ;;
        esac
        is_ipv6_cidr "$inet" || continue
        if [ -n "$gw" ]; then
            is_ipv6_addr "$gw" || continue
        fi
        ip -6 addr add "$inet" dev eth0 2>/dev/null || true
        if [ -n "$gw" ]; then
            ip -6 route replace default via "$gw" dev eth0 2>/dev/null || true
        fi
        break
    done < "$IPV6_CONFIG_FILE"
}

apply_ipv6() {
    case "$(read_ipv6_mode)" in
        slaac) apply_ipv6_slaac ;;
        dhcpv6) apply_ipv6_dhcpv6 ;;
        manual) apply_ipv6_manual ;;
        disabled|*) apply_ipv6_disabled ;;
    esac
}

calc_gw() {
    addr="$1"
    netid="$2"
    is_ipv4_addr "$addr" || return 1
    is_ipv4_netid "$netid" || return 1
    IFS=. read a b c d <<EOF
$addr
EOF
    ipnum=$(( (a<<24) + (b<<16) + (c<<8) + d ))
    mask=$(( 0xFFFFFFFF << (32-netid) & 0xFFFFFFFF ))
    gwnum=$(( (ipnum & mask) | 1 ))
    if [ $gwnum -eq $ipnum ]; then
        broadcast=$(( (ipnum & mask) | (0xFFFFFFFF & ~mask) ))
        gwnum=$(( broadcast - 1 ))
    fi
    echo "$(( (gwnum>>24)&255 )).$(( (gwnum>>16)&255 )).$(( (gwnum>>8)&255 )).$(( gwnum&255 ))"
}

render_static_dns() {
    fallback_server="$1"
    tmp="${ETC_RESOLV_FILE}.tmp.$$"
    : > "$tmp" || return 1

    if [ -s "$BOOT_RESOLV_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line=$(clean_line "$line")
            [ -z "$line" ] && continue
            set -- $line
            case "$1" in
                nameserver)
                    [ "$#" -eq 2 ] || continue
                    if is_ipv4_addr "$2" || is_ipv6_addr "$2"; then
                        printf 'nameserver %s\n' "$2" >>"$tmp" || { rm -f "$tmp"; return 1; }
                    fi
                    ;;
                search|domain)
                    [ "$#" -ge 2 ] || continue
                    safe=1
                    for name in "$@"; do
                        [ "$name" = "$1" ] && continue
                        case "$name" in
                            ''|*[!A-Za-z0-9._-]*) safe=0 ;;
                        esac
                    done
                    if [ "$safe" -eq 1 ]; then
                        printf '%s\n' "$line" >>"$tmp" || { rm -f "$tmp"; return 1; }
                    fi
                    ;;
                options)
                    [ "$#" -ge 2 ] || continue
                    safe=1
                    for option in "$@"; do
                        [ "$option" = "$1" ] && continue
                        case "$option" in
                            ndots:[0-9]|ndots:[0-9][0-9]|timeout:[0-9]|timeout:[0-9][0-9]|attempts:[0-9]|rotate|single-request|single-request-reopen|no-tld-query) ;;
                            *) safe=0 ;;
                        esac
                    done
                    if [ "$safe" -eq 1 ]; then
                        printf '%s\n' "$line" >>"$tmp" || { rm -f "$tmp"; return 1; }
                    fi
                    ;;
            esac
        done < "$BOOT_RESOLV_FILE"
    fi

    if [ -s "$tmp" ]; then
        dedup="${tmp}.dedup"
        awk '
            $1 == "nameserver" {
                if (!seen[$2]++) print "nameserver " $2
                next
            }
            { print }
        ' "$tmp" >"$dedup" || { rm -f "$dedup" "$tmp"; return 1; }
        mv "$dedup" "$tmp" || { rm -f "$dedup" "$tmp"; return 1; }
    fi

    if ! grep -q '^nameserver ' "$tmp" 2>/dev/null; then
        printf 'nameserver %s\n' "$fallback_server" >>"$tmp" || { rm -f "$tmp"; return 1; }
    fi

    chmod 0644 "$tmp" 2>/dev/null || true
    mv "$tmp" "$ETC_RESOLV_FILE"
}

start() {
    ensure_eth_mac
    ip -4 addr flush dev eth0
    if [ -e /boot/eth.nodhcp ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line=$(clean_line "$line")
            [ -z "$line" ] && continue
            set -- $line
            inet="$1"
            gw="$2"
            [ -n "$inet" ] || continue
            case "$inet" in
                */*)
                    netid_check="${inet#*/}"
                    is_ipv4_netid "$netid_check" || inet="${inet%/*}/16"
                    ;;
                *)
                    inet="$inet/16"
                    ;;
            esac
            addr="${inet%/*}"
            netid="${inet#*/}"
            is_ipv4_addr "$addr" || continue
            is_ipv4_netid "$netid" || continue
            if [ -n "$gw" ]; then
                is_ipv4_addr "$gw" || continue
            else
                gw=$(calc_gw "$addr" "$netid") || continue
            fi
            [ -n "$gw" ] || continue
            arping -Dqc2 -Ieth0 "$addr" || continue
            ip a add "$inet" brd + dev eth0
            ip r add default via "$gw" dev eth0
            render_static_dns "$gw"
            break
        done < /boot/eth.nodhcp

        ip a show dev eth0 | grep 'inet ' > /dev/null || {
            udhcpc -i eth0 -t 3 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid >/dev/null 2>&1
            ip a show dev eth0 | grep 'inet ' > /dev/null
        } || {
            inet=$RESERVE_INET
            addr=${inet%/*}
            ip a add "$inet" brd + dev eth0
        } || exit 1
    else
        udhcpc -i eth0 -t 10 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid &
    fi

    apply_ipv6
}

stop() {
    if [ -e "/run/udhcpc.eth0.pid" ]; then
        kill "$(cat /run/udhcpc.eth0.pid)" 2>/dev/null || true
        rm -f /run/udhcpc.eth0.pid
    fi
    stop_dhcpv6
}

if [ "${S30ETH_TEST_ONLY:-}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload)
        $0 stop
        $0 start
        ;;
    *) exit 1 ;;
esac
