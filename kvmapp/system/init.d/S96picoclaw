#!/bin/sh

umask 077

start_service() {
  /usr/libexec/nanokvm-native-ctl picoclaw-control-ready >/dev/null || return $?
  /usr/libexec/nanokvm-native-ctl ensure-picoclaw
}

onboard_service() {
  /usr/libexec/nanokvm-native-ctl picoclaw-control-ready >/dev/null || return $?
  /usr/libexec/nanokvm-native-ctl onboard-picoclaw
}

stop_service() {
  /usr/libexec/nanokvm-native-ctl picoclaw-control-ready >/dev/null || return $?
  /usr/libexec/nanokvm-native-ctl stop-picoclaw
}

[ "$#" -eq 1 ] || {
  echo "Usage: $0 {start|stop|onboard|restart}" >&2
  exit 64
}

case "$1" in
  start)
    start_service
    ;;

  stop)
    stop_service
    ;;

  onboard)
    onboard_service
    ;;

  restart)
    stop_service || exit $?
    start_service
    ;;

  *)
    echo "Usage: $0 {start|stop|onboard|restart}"
    exit 1
    ;;
esac
