#!/bin/sh
if [ -e /run/nanokvm-restore-blocked ]; then
    echo "$0: raw restore is blocked" >&2
    exit 1
fi

. /etc/profile
# /etc/profile sets 022. Everything this script writes holds a Wi-Fi secret.
umask 077
LC_ALL=C
export LC_ALL

# Opens the Wi-Fi routes that need no login, so only root may create it.
APFLAG_FILE=/run/nanokvm-wifiap
AP_GUARD_CHAIN=NKVM-AP-INGRESS
rm -f /tmp/wifiap

# Write stdin to $1 through a private temporary file, so that the file is never
# readable by others, whatever mode an earlier writer left on it.
write_private() {
    [ ! -d "$1" ] || return 1
    private_tmp=$(mktemp "$1.XXXXXX") || return 1
    if chmod 600 "$private_tmp" && cat > "$private_tmp" && mv -f "$private_tmp" "$1"; then
        return 0
    fi
    rm -f "$private_tmp"
    return 1
}
chmod 600 /etc/kvm/wifi.ssid /etc/kvm/wifi.pass /etc/wpa_supplicant.conf /etc/hostapd.conf 2>/dev/null

gen_hostapd_conf() {
    ssid="${1}"
    pass="${2}"
    echo "ctrl_interface=/var/run/hostapd"
    echo "ctrl_interface_group=0"
    printf 'ssid=%s\n' "$ssid"
    echo "hw_mode=g"
    echo "channel=1"
    echo "beacon_int=100"
    echo "dtim_period=2"
    echo "max_num_sta=255"
    echo "rts_threshold=-1"
    echo "fragm_threshold=-1"
    echo "macaddr_acl=0"
    echo "auth_algs=3"
    echo "wpa=2"
    printf 'wpa_passphrase=%s\n' "$pass"
    echo "ieee80211n=1"
}

# Accept one text record (with or without a final newline). Check the file
# before command substitution, which would discard trailing newlines.
valid_ap_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    awk 'NR > 1 || /[[:cntrl:]]/ { bad = 1 } END { exit (bad || NR != 1) }' "$1"
}

install_ap_guard() {
    # mangle INPUT sees the final local destination after DNAT and runs before
    # any filter-table ACCEPT (including established traffic and mode changes).
    iptables -w 2 -t mangle -N "$AP_GUARD_CHAIN" 2>/dev/null || true
    iptables -w 2 -t mangle -F "$AP_GUARD_CHAIN" || return 1
    iptables -w 2 -t mangle -A "$AP_GUARD_CHAIN" -d "$1" ! -i wlan0 -j DROP || return 1
    iptables -w 2 -t mangle -D INPUT -j "$AP_GUARD_CHAIN" 2>/dev/null || true
    iptables -w 2 -t mangle -I INPUT 1 -j "$AP_GUARD_CHAIN" || return 1
    iptables -w 2 -t mangle -C INPUT -j "$AP_GUARD_CHAIN" || return 1
    iptables -w 2 -t mangle -C "$AP_GUARD_CHAIN" -d "$1" ! -i wlan0 -j DROP
}

remove_ap_guard() {
    iptables -w 2 -t mangle -D INPUT -j "$AP_GUARD_CHAIN" 2>/dev/null || true
    iptables -w 2 -t mangle -F "$AP_GUARD_CHAIN" 2>/dev/null || true
    iptables -w 2 -t mangle -X "$AP_GUARD_CHAIN" 2>/dev/null || true
}

gen_udhcpd_conf() {
    interface=${1}
    ipv4_prefix=${2}
    echo "start ${ipv4_prefix}.100"
    echo "end ${ipv4_prefix}.200"
    echo "interface ${interface}"
    echo "pidfile /var/run/udhcpd.${interface}.pid"
    echo "lease_file /var/lib/misc/udhcpd.${interface}.leases"
    echo "option subnet 255.255.255.0"
    echo "option lease 864000"
}

gen_dnsmasq_conf() {
    ipv4_prefix=${1}
    echo "bind-interfaces"
    echo "interface=wlan0"
    echo "address=/config.kvm/${ipv4_prefix}.1"
    echo "no-hosts"
    echo "dhcp-range=${ipv4_prefix}.2,${ipv4_prefix}.254"
    echo "dhcp-option=6,${ipv4_prefix}.1"
    echo "dhcp-option=3,${ipv4_prefix}.1"
    echo "dhcp-authoritative"
}

start() {
    echo "wifi mode: sta"
    ssid=""
    pass=""
    if [ -e /boot/wifi.ssid ] && [ -e /boot/wifi.pass ]; then
        echo "Updating WiFi credentials from /boot to /etc/kvm/"

        rm -f /etc/kvm/wifi.ssid /etc/kvm/wifi.pass

        mv /boot/wifi.ssid /etc/kvm/wifi.ssid
        mv /boot/wifi.pass /etc/kvm/wifi.pass

        chown root:root /etc/kvm/wifi.ssid /etc/kvm/wifi.pass
        chmod 600 /etc/kvm/wifi.ssid /etc/kvm/wifi.pass
    fi
    if [ -e /etc/kvm/wifi.ssid ]; then
        ssid=$(cat /etc/kvm/wifi.ssid)
    fi
    if [ -e /etc/kvm/wifi.pass ]; then
        pass=$(cat /etc/kvm/wifi.pass)
    fi
    # wpa_passphrase also prints the passphrase itself as a comment.
    station_conf=$(wpa_passphrase "$ssid" "$pass") || return 1
    {
        echo "ctrl_interface=/var/run/wpa_supplicant"
        printf '%s\n' "$station_conf" | sed '/^[[:space:]]*#psk=/d'
    } | write_private /etc/wpa_supplicant.conf || return 1
    unset station_conf pass
    wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf || return 1
    if [ ! -e /boot/wifi.nodhcp ]; then
        (udhcpc -i wlan0 -t 10 -T 1 -A 5 -b -p /run/udhcpc.wlan0.pid) &
    fi
}

ap_start() {
    /usr/libexec/nanokvm-app-recovery gate >/dev/null || return 1
    if ! valid_ap_file /kvmapp/kvm/ap.ssid || ! valid_ap_file /kvmapp/kvm/ap.pass; then
        echo "invalid AP credential file" >&2
        return 1
    fi
    echo "wifi mode: ap"
    id2=$(printf "%d" 0x$(sha512sum /sys/class/cvi-base/base_uid | head -c 2))
    id3=$(printf "%d" 0x$(sha512sum /sys/class/cvi-base/base_uid | head -c 4 | tail -c 2))
    if [ "$id2" = "$id3" ]; then
        id2=$((id2 + 1))
    fi
    if [ "$id2" -ge 255 ]; then
        id2=253
    fi
    if [ "$id3" -ge 255 ]; then
        id3=254
    fi
    ssid=""
    pass=""
    if [ -e /kvmapp/kvm/ap.ssid ]; then
        ssid=$(cat /kvmapp/kvm/ap.ssid)
    fi
    if [ -e /kvmapp/kvm/ap.pass ]; then
        pass=$(cat /kvmapp/kvm/ap.pass)
    fi
    if [ "${#ssid}" -lt 1 ] || [ "${#ssid}" -gt 32 ] ||
       [ "${#pass}" -lt 8 ] || [ "${#pass}" -gt 63 ]; then
        echo "invalid AP credential length" >&2
        return 1
    fi
    gen_hostapd_conf "$ssid" "$pass" | write_private /etc/hostapd.conf || return 1
    unset pass
    ipv4_prefix=10.$id3.$id2
    gen_udhcpd_conf wlan0 "${ipv4_prefix}" | write_private /etc/udhcpd.wlan0.conf || return 1
    # gen_dnsmasq_conf "${ipv4_prefix}"  > /etc/dnsmasq.conf

    # iptables --policy INPUT ACCEPT
    # iptables --policy FORWARD ACCEPT
    # iptables --policy OUTPUT ACCEPT
    # iptables -F
    # iptables -t nat -F
    # iptables -t nat -A PREROUTING -i wlan0 -p udp --dport 53 -j DNAT --to ${ipv4_prefix}.1

    ifconfig wlan0 up || return 1
    ip route del default || true
    ip add flush dev wlan0 || return 1
    ip addr add "$ipv4_prefix.1/24" dev wlan0 || return 1
    install_ap_guard "$ipv4_prefix.1" || { stop; return 1; }
    # dnsmasq --pid-file=/tmp/dnsmasq.run -C /etc/dnsmasq.conf
    hostapd -B -i wlan0 /etc/hostapd.conf || { stop; return 1; }
    udhcpd -S /etc/udhcpd.wlan0.conf || { stop; return 1; }
    printf '%s\n' "$ipv4_prefix.1" | write_private "$APFLAG_FILE" || { stop; return 1; }

}

stop() {
    # Revoke provisioning before stopping daemons or changing interfaces.
    rm -f "$APFLAG_FILE" || return 1
    remove_ap_guard
    ps -ef | grep hostapd | grep -v grep | awk '{print $1}' | xargs kill -2 || true
    ps -ef | grep "udhcpd -S /etc/udhcpd.wlan0.conf" | grep -v grep | awk '{print $1}' | xargs kill -2 || true
    killall wpa_supplicant || true
    if [ -e /run/udhcpc.wlan0.pid ]; then
        kill $(cat /run/udhcpc.wlan0.pid) || true
        rm -f /run/udhcpc.wlan0.pid
    fi
    if [ -e /var/run/udhcpd.wlan0.pid ]; then
        kill $(cat /var/run/udhcpd.wlan0.pid) || true
        rm -f /var/run/udhcpd.wlan0.pid
    fi
    if [ -f /tmp/dnsmasq.run ] && [ ! -L /tmp/dnsmasq.run ] && [ -O /tmp/dnsmasq.run ]; then
        kill $(cat /tmp/dnsmasq.run) || true
        rm -f /tmp/dnsmasq.run
    fi
    # if [ -e /etc/wpa_supplicant.conf]
    # then
    # 	echo > /etc/wpa_supplicant.conf
    # fi
    airmon-ng stop wlan0mon || true

}

restart() {
    stop || return 1
    start
}

if [ "${1}" = "start" ]; then
    start
elif [ "${1}" = "stop" ]; then
    stop
elif [ "${1}" = "ap" ]; then
    stop || exit 1
    ap_start
elif [ "${1}" = "restart" ]; then
    restart
fi
