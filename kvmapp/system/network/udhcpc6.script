#!/bin/sh

[ -z "$1" ] && echo "Error: should be called from udhcpc6" && exit 1
[ -n "$interface" ] || interface=eth0

ACTION="$1"
TAG="$interface-dhcpv6"
RESOLV_CONF="/etc/resolv.conf"
[ -e /boot/resolv.conf ] && RESOLV_CONF="/etc/resolv.conf.dhcp6"
[ -e "$RESOLV_CONF" ] || touch "$RESOLV_CONF"
# The /128 that this hook added, so that it can be removed again.
ADDRESS_FILE="/run/udhcpc6.$interface.address"

# Values come from the DHCPv6 server: only an IPv6 address literal, or a
# space-separated list of domain names, may reach ip or resolv.conf.
valid_ipv6() {
    case "$1" in
        *:*) ;;
        *) return 1 ;;
    esac
    case "$1" in
        *[!0-9A-Fa-f:.]*|*:::*) return 1 ;;
    esac
    return 0
}

valid_domains() {
    case "$1" in
        ""|*[!A-Za-z0-9.\ -]*) return 1 ;;
    esac
    return 0
}

remove_dns() {
    tmp=$(mktemp)
    grep -vE "# $TAG\$" "$RESOLV_CONF" > "$tmp" 2>/dev/null || true
    cat "$tmp" > "$RESOLV_CONF"
    rm -f "$tmp"
}

write_dns() {
    remove_dns

    if valid_domains "$search"; then
        echo "search $search # $TAG" >> "$RESOLV_CONF"
    elif valid_domains "$domain"; then
        echo "search $domain # $TAG" >> "$RESOLV_CONF"
    fi

    for server in $dns
    do
        valid_ipv6 "$server" && echo "nameserver $server # $TAG" >> "$RESOLV_CONF"
    done
}

remove_address() {
    [ -r "$ADDRESS_FILE" ] || return 0
    address="$(cat "$ADDRESS_FILE")"
    valid_ipv6 "$address" && ip -6 addr del "$address/128" dev "$interface" 2>/dev/null
    rm -f "$ADDRESS_FILE"
}

case "$ACTION" in
    deconfig)
        # Do not touch IPv4 here. The stock udhcpc script resets eth0 to
        # 0.0.0.0 on deconfig, which breaks the active web/SSH session.
        remove_address
        remove_dns
        ;;
    bound|renew)
        # The new address first: a lease that cannot be applied keeps the old.
        if valid_ipv6 "$ipv6" && {
            ip -6 addr replace "$ipv6/128" dev "$interface" 2>/dev/null ||
                ip -6 addr add "$ipv6/128" dev "$interface" 2>/dev/null
        }; then
            [ "$(cat "$ADDRESS_FILE" 2>/dev/null)" = "$ipv6" ] || remove_address
            echo "$ipv6" > "$ADDRESS_FILE"
        fi
        [ -n "$dns" ] && write_dns
        ;;
esac

exit 0
