# BusyBox 1.38.0 built as the bundled /kvmapp/system/bin/udhcpc6: one static
# applet, the DHCPv6 client with the RFC 3646 DNS options the hook reads
# ($ipv6, $dns, $search, $domain). No shell, no other applets, no dynamic
# loader, so the binary does not depend on the rootfs libc or BusyBox.
CONFIG_STATIC=y
CONFIG_STATIC_LIBGCC=y
CONFIG_LFS=y
# FEATURE_SYSLOG has no prompt (applets select it); S30eth passes no -S.
# UDHCPC6 depends on FEATURE_IPV6.
CONFIG_FEATURE_IPV6=y
CONFIG_UDHCPC6=y
CONFIG_FEATURE_UDHCPC6_RFC3646=y
# CONFIG_FEATURE_UDHCPC6_RFC4704 is not set
# CONFIG_FEATURE_UDHCPC6_RFC4833 is not set
# CONFIG_FEATURE_UDHCPC6_RFC5970 is not set
# RFC3397 and the buggy-server slack belong to the IPv4 client, which stays off.
CONFIG_UDHCPC6_DEFAULT_SCRIPT="/kvmapp/system/network/udhcpc6.script"
CONFIG_UDHCPC_DEFAULT_INTERFACE="eth0"
CONFIG_UDHCP_DEBUG=0
# CONFIG_UDHCPC is not set
# CONFIG_UDHCPD is not set
# CONFIG_FEATURE_UDHCP_PORT is not set
# allnoconfig still aliases sh to ash; no shell at all.
CONFIG_SH_IS_NONE=y
# CONFIG_SH_IS_ASH is not set
# CONFIG_SHELL_ASH is not set
# CONFIG_ASH is not set
CONFIG_BASH_IS_NONE=y
# CONFIG_BUSYBOX is not set
# CONFIG_FEATURE_INSTALLER is not set
# CONFIG_FEATURE_SUID is not set
# CONFIG_FEATURE_PREFER_APPLETS is not set
# CONFIG_FEATURE_SH_STANDALONE is not set
# CONFIG_PIE is not set
